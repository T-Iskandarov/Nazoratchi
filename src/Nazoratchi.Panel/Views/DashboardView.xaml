<UserControl x:Class="Nazoratchi.Panel.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header with Refresh Button -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <Button DockPanel.Dock="Right" Click="RefreshButton_Click" 
                    Height="40" Padding="16,0" Cursor="Hand" Background="White" BorderBrush="#0066FF">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1.5" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Foreground="#0066FF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="YANGILASH" VerticalAlignment="Center" FontWeight="Bold" FontSize="13" Foreground="#0066FF"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <TextBlock Text="Bosh sahifa" FontSize="28" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
        </DockPanel>

        <!-- 4 Summary Cards matching Image 2 -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,20">
            <!-- Card 1: Blocked Sites -->
            <Border Background="White" CornerRadius="14" Padding="20" Margin="0,0,16,0" BorderBrush="#EBF2FC" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#64748B" BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.06" />
                </Border.Effect>
                <StackPanel>
                    <Border Background="#EFF6FF" Width="40" Height="40" CornerRadius="20" HorizontalAlignment="Left">
                        <materialDesign:PackIcon Kind="Earth" Width="20" Height="20" Foreground="#0066FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Bugun bloklangan saytlar" Foreground="#64748B" FontSize="13" Margin="0,12,0,4" />
                    <TextBlock x:Name="BlockedSitesCount" Text="0" FontSize="30" FontWeight="Bold" Foreground="#0F172A"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Blocked Apps -->
            <Border Background="White" CornerRadius="14" Padding="20" Margin="0,0,16,0" BorderBrush="#EBF2FC" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#64748B" BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.06" />
                </Border.Effect>
                <StackPanel>
                    <Border Background="#EEF2FF" Width="40" Height="40" CornerRadius="20" HorizontalAlignment="Left">
                        <materialDesign:PackIcon Kind="Apps" Width="20" Height="20" Foreground="#4F46E5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Bugun bloklangan dasturlar" Foreground="#64748B" FontSize="13" Margin="0,12,0,4" />
                    <TextBlock x:Name="BlockedAppsCount" Text="0" FontSize="30" FontWeight="Bold" Foreground="#0F172A"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Filter Mode -->
            <Border Background="White" CornerRadius="14" Padding="20" Margin="0,0,16,0" BorderBrush="#EBF2FC" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#64748B" BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.06" />
                </Border.Effect>
                <StackPanel>
                    <Border Background="#FFF7ED" Width="40" Height="40" CornerRadius="20" HorizontalAlignment="Left">
                        <materialDesign:PackIcon Kind="FilterVariant" Width="20" Height="20" Foreground="#EA580C" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Filtrlash rejimi" Foreground="#64748B" FontSize="13" Margin="0,12,0,4" />
                    <TextBlock x:Name="FilterModeText" Text="Qora ro'yxat" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Service Status -->
            <Border Background="White" CornerRadius="14" Padding="20" BorderBrush="#EBF2FC" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#64748B" BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.06" />
                </Border.Effect>
                <StackPanel>
                    <Border Background="#ECFDF5" Width="40" Height="40" CornerRadius="20" HorizontalAlignment="Left">
                        <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="20" Height="20" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Xizmat holati" Foreground="#64748B" FontSize="13" Margin="0,12,0,6" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon x:Name="ServiceStatusIcon" Kind="CheckCircle" Foreground="#16A34A" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="ServiceStatusText" Text="Ishlamoqda" FontSize="20" FontWeight="Bold" Foreground="#16A34A" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Bottom Card: Recent Activities matching Image 2 -->
        <Border Grid.Row="2" Background="White" CornerRadius="14" Padding="20" BorderBrush="#EBF2FC" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#64748B" BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.06" />
            </Border.Effect>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Background="#EFF6FF" Width="32" Height="32" CornerRadius="16" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="ClockOutline" Width="18" Height="18" Foreground="#0066FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="So'nggi faolliklar" FontSize="18" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                </StackPanel>

                <DataGrid x:Name="RecentLogsGrid" AutoGenerateColumns="False" IsReadOnly="True" 
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" 
                          HorizontalGridLinesBrush="#F1F5F9" Background="Transparent" BorderThickness="0"
                          RowHeight="42" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Vaqt" Binding="{Binding Timestamp}" Width="170" />
                        <DataGridTextColumn Header="Tur" Binding="{Binding Type}" Width="110" />
                        <DataGridTextColumn Header="Tafsilot" Binding="{Binding Detail}" Width="*" />
                        <DataGridTemplateColumn Header="Natija" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#FEE2E2" CornerRadius="6" Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Result}" Foreground="#DC2626" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
