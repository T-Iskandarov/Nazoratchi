<UserControl x:Class="Nazoratchi.Panel.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="Segoe UI">
    <Grid Margin="0,0,8,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header with Refresh Button -->
        <DockPanel Grid.Row="0" Margin="0,0,0,24">
            <Button DockPanel.Dock="Right" Click="RefreshButton_Click" 
                    Style="{StaticResource AppSecondaryButtonStyle}" Height="40">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Foreground="#0066FF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="YANGILASH" VerticalAlignment="Center" FontWeight="Bold" FontSize="13" Foreground="#0066FF"/>
                </StackPanel>
            </Button>
            <TextBlock Text="Bosh sahifa" FontSize="26" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
        </DockPanel>

        <!-- 4 Summary Metric Cards -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,24">
            <!-- Card 1: Blocked Sites -->
            <Border Background="White" CornerRadius="16" Padding="20" Margin="0,0,16,0" 
                    BorderBrush="#EBF2FC" BorderThickness="1" Effect="{StaticResource CardElevationEffect}">
                <StackPanel>
                    <Border Background="#EFF6FF" Width="44" Height="44" CornerRadius="22" HorizontalAlignment="Left">
                        <materialDesign:PackIcon Kind="Earth" Width="22" Height="22" Foreground="#0066FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Bugun bloklangan saytlar" Foreground="#64748B" FontSize="13" FontWeight="Medium" Margin="0,14,0,4" />
                    <TextBlock x:Name="BlockedSitesCount" Text="0" FontSize="28" FontWeight="Bold" Foreground="#0F172A"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Blocked Apps -->
            <Border Background="White" CornerRadius="16" Padding="20" Margin="0,0,16,0" 
                    BorderBrush="#EBF2FC" BorderThickness="1" Effect="{StaticResource CardElevationEffect}">
                <StackPanel>
                    <Border Background="#EEF2FF" Width="44" Height="44" CornerRadius="22" HorizontalAlignment="Left">
                        <materialDesign:PackIcon Kind="Apps" Width="22" Height="22" Foreground="#4F46E5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Bugun bloklangan dasturlar" Foreground="#64748B" FontSize="13" FontWeight="Medium" Margin="0,14,0,4" />
                    <TextBlock x:Name="BlockedAppsCount" Text="0" FontSize="28" FontWeight="Bold" Foreground="#0F172A"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Filter Mode -->
            <Border Background="White" CornerRadius="16" Padding="20" Margin="0,0,16,0" 
                    BorderBrush="#EBF2FC" BorderThickness="1" Effect="{StaticResource CardElevationEffect}">
                <StackPanel>
                    <Border Background="#FFF7ED" Width="44" Height="44" CornerRadius="22" HorizontalAlignment="Left">
                        <materialDesign:PackIcon Kind="FilterVariant" Width="22" Height="22" Foreground="#EA580C" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Filtrlash rejimi" Foreground="#64748B" FontSize="13" FontWeight="Medium" Margin="0,14,0,4" />
                    <TextBlock x:Name="FilterModeText" Text="Qora ro'yxat" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Service Status -->
            <Border Background="White" CornerRadius="16" Padding="20" 
                    BorderBrush="#EBF2FC" BorderThickness="1" Effect="{StaticResource CardElevationEffect}">
                <StackPanel>
                    <Border Background="#ECFDF5" Width="44" Height="44" CornerRadius="22" HorizontalAlignment="Left">
                        <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="22" Height="22" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Xizmat holati" Foreground="#64748B" FontSize="13" FontWeight="Medium" Margin="0,14,0,6" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon x:Name="ServiceStatusIcon" Kind="CheckCircle" Foreground="#16A34A" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="ServiceStatusText" Text="Ishlamoqda" FontSize="20" FontWeight="Bold" Foreground="#16A34A" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Bottom Card: Recent Activities -->
        <Border Grid.Row="2" Background="White" CornerRadius="16" Padding="24,20" 
                BorderBrush="#EBF2FC" BorderThickness="1" Effect="{StaticResource CardElevationEffect}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Background="#EFF6FF" Width="36" Height="36" CornerRadius="18" Margin="0,0,12,0">
                        <materialDesign:PackIcon Kind="ClockOutline" Width="18" Height="18" Foreground="#0066FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="So'nggi faolliklar" FontSize="18" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                </StackPanel>

                <DataGrid x:Name="RecentLogsGrid" AutoGenerateColumns="False" IsReadOnly="True" 
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" 
                          HorizontalGridLinesBrush="#F1F5F9" Background="Transparent" BorderThickness="0"
                          RowHeight="42" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Vaqt" Binding="{Binding Timestamp}" Width="170" />
                        <DataGridTextColumn Header="Tur" Binding="{Binding Type}" Width="110" />
                        <DataGridTextColumn Header="Tafsilot" Binding="{Binding Detail}" Width="*" />
                        <DataGridTemplateColumn Header="Natija" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#FEE2E2" CornerRadius="6" Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Result}" Foreground="#DC2626" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
