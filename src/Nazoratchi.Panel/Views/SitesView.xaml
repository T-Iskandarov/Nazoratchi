<UserControl x:Class="Nazoratchi.Panel.Views.SitesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,0,10,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="Earth" Width="28" Height="28" Foreground="#0066FF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Saytlarni boshqarish" FontSize="26" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Active Mode Selector & AI Protection Card -->
            <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,16" 
                    BorderBrush="#EBF2FC" BorderThickness="1" Effect="{StaticResource CardElevationEffect}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Faol rejim:" FontWeight="Bold" FontSize="14" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,24,0" />
                        <RadioButton x:Name="BlacklistRadio" Content="Qora ro'yxat (Taqiqlanganlar)" 
                                     GroupName="ActiveFilterMode" FontSize="14" Foreground="#1E293B" Margin="0,0,24,0" 
                                     Checked="ActiveMode_Changed" />
                        <RadioButton x:Name="WhitelistRadio" Content="Oq ro'yxat (Faqat ruxsat berilganlar)" 
                                     GroupName="ActiveFilterMode" FontSize="14" Foreground="#1E293B" 
                                     Checked="ActiveMode_Changed" />
                    </StackPanel>

                    <!-- AI and YouTube Protection Card (Modern UX/UI) -->
                    <Border Background="#FFF5F5" BorderBrush="#FECDD3" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Modern Icon Badge -->
                            <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" Background="#FFE4E6" 
                                    VerticalAlignment="Center" Margin="0,0,14,0">
                                <materialDesign:PackIcon Kind="ShieldAlertOutline" Width="24" Height="24" 
                                                         Foreground="#E11D48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Content with Checkbox -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <CheckBox x:Name="BlockAiCheckBox" 
                                          Checked="BlockAiCheckBox_Changed" Unchecked="BlockAiCheckBox_Changed"
                                          Cursor="Hand" Margin="0" Padding="8,0,0,0">
                                    <CheckBox.Content>
                                        <TextBlock Text="Sun'iy intellekt (AI) va YouTube videolarni qat'iy bloklash" 
                                                   FontSize="14" FontWeight="Bold" Foreground="#881337" VerticalAlignment="Center"/>
                                    </CheckBox.Content>
                                </CheckBox>
                                <TextBlock Text="ChatGPT, Gemini, Claude, Grok, DeepSeek hamda YouTube (barcha videolar) — oq yoki qora ro'yxatdan qat'i nazar 100% bloklanadi." 
                                           FontSize="12" Foreground="#9F1239" Margin="30,3,0,0" TextWrapping="Wrap" Opacity="0.9" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Native TabControl with Modern Segmented Tabs -->
            <TabControl x:Name="SitesTabControl" SelectionChanged="SitesTabControl_SelectionChanged" Grid.Row="2" Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Foreground" Value="#475569" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="TabBorder" CornerRadius="8" Padding="20,10" Margin="0,0,12,12" 
                                            Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand">
                                        <ContentPresenter ContentSource="Header" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="#0066FF" />
                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="#0066FF" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="#0066FF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- TAB 1: BLACKLIST -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Cancel" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Qora ro'yxat" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                            <Border x:Name="BlacklistActivePill" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="10" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Visible">
                                <TextBlock Text="Faol" Foreground="#16A34A" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </TabItem.Header>

                    <StackPanel>
                        <!-- Main Card -->
                        <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,16" 
                                BorderBrush="#EBF2FC" BorderThickness="1" Effect="{StaticResource CardElevationEffect}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <materialDesign:PackIcon Kind="FileDocumentOutline" Width="20" Height="20" Foreground="#0066FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Taqiqlanadigan saytlar ro'yxati (har bir qatorga bittadan):" 
                                               FontWeight="Bold" FontSize="14" Foreground="#0F172A" VerticalAlignment="Center" />
                                </StackPanel>
                                
                                <Border Background="White" BorderBrush="#0066FF" BorderThickness="1.5" CornerRadius="8" Padding="2">
                                    <TextBox x:Name="BlacklistTextBox" 
                                             AcceptsReturn="True" 
                                             VerticalScrollBarVisibility="Auto" 
                                             Height="105" 
                                             FontSize="14" 
                                             FontFamily="Consolas"
                                             Foreground="#0F172A"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="8" />
                                </Border>

                                <!-- Button Actions Row -->
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0" VerticalAlignment="Center">
                                    <!-- Save Button -->
                                    <Button Click="SaveBlacklistButton_Click" Style="{StaticResource AppPrimaryButtonStyle}" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="ContentSaveOutline" Width="18" Height="18" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="RO'YXATNI SAQLASH" Foreground="White" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Sort Button -->
                                    <Button Click="SortBlacklistButton_Click" Style="{StaticResource AppSecondaryButtonStyle}" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="SortAlphabeticalAscending" Width="18" Height="18" Foreground="#0066FF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="ALIFBO BO'YICHA SARALASH" Foreground="#0066FF" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Clear Button -->
                                    <Button Click="ClearBlacklistText_Click" Style="{StaticResource AppDangerSoftButtonStyle}" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18" Foreground="#DC2626" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="TOZALASH" Foreground="#DC2626" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- In-page Save Notification Badge -->
                                    <Border x:Name="BlacklistNotificationBadge" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="10,6" Visibility="Collapsed" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CheckCircleOutline" Width="16" Height="16" Foreground="#059669" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="BlacklistNotificationText" Text="Qora ro'yxat saqlandi" Foreground="#065F46" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- LeechBlock Rules Box -->
                        <Border Background="#F0F8FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <materialDesign:PackIcon Kind="LightbulbOutline" Width="18" Height="18" Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Qoidalar va Maslahatlar (LeechBlock uslubida):" FontWeight="Bold" FontSize="13" Foreground="#0369A1" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="• &quot;*&quot; yoki &quot;**&quot; — ixtiyoriy subdomen yoki qism (masalan: *.youtube.com, *game*, *bet)" FontSize="12.5" Foreground="#334155" Margin="0,0,0,3"/>
                                <TextBlock Text="• &quot;+&quot; — istisno qoida (masalan: +mail.google.com ga ruxsat beriladi, boshqa google xizmatlari bloklanadi)" FontSize="12.5" Foreground="#334155" Margin="0,0,0,3"/>
                                <TextBlock Text="• &quot;~&quot; — kalit so'z (masalan: ~bet domen nomida &quot;bet&quot; so'zi bo'lgan barcha saytlarni to'xtatadi)" FontSize="12.5" Foreground="#334155"/>
                            </StackPanel>
                        </Border>

                        <!-- Saved Sites Table -->
                        <Border Background="White" CornerRadius="14" Padding="20,16" 
                                BorderBrush="#EBF2FC" BorderThickness="1" Effect="{StaticResource CardElevationEffect}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,14">
                                    <!-- Modern Search Capsule with Focus Ring -->
                                    <Border DockPanel.Dock="Right" Style="{StaticResource ModernInputContainerStyle}"
                                            Height="38" Width="260" Padding="12,0" VerticalAlignment="Center">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            
                                            <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="18" Height="18" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            
                                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock x:Name="SearchBlacklistPlaceholder" Text="Saytlarni qidirish..." Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                                <TextBox x:Name="SearchBlacklistTextBox" TextChanged="SearchBlacklist_TextChanged" 
                                                         Background="Transparent" BorderThickness="0" FontSize="13" Foreground="#0F172A" VerticalContentAlignment="Center" Padding="0"/>
                                            </Grid>
                                            
                                            <Button x:Name="ClearSearchBlacklistBtn" Grid.Column="2" Click="ClearSearchBlacklist_Click"
                                                    Width="20" Height="20" Background="Transparent" BorderThickness="0" Cursor="Hand" Visibility="Collapsed" Padding="0" VerticalAlignment="Center">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <materialDesign:PackIcon Kind="CloseCircle" Width="16" Height="16" Foreground="#94A3B8"/>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Title with count pill -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="FormatListBulleted" Width="20" Height="20" Foreground="#0066FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Saqlangan qora ro'yxat saytlari" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                        <Border Background="#EFF6FF" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="BlacklistCountBadge" Text="0 ta" Foreground="#0066FF" FontWeight="Bold" FontSize="12" />
                                        </Border>
                                    </StackPanel>
                                </DockPanel>

                                <Grid MinHeight="140">
                                    <DataGrid x:Name="BlacklistGrid" AutoGenerateColumns="False" IsReadOnly="True" 
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" 
                                              HorizontalGridLinesBrush="#F1F5F9" Background="Transparent" BorderThickness="0"
                                              RowHeight="42" FontSize="13">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Domen / Qoida" Binding="{Binding Domain}" Width="*" />
                                            <DataGridTextColumn Header="Qo'shilgan sana" Binding="{Binding AddedDate}" Width="190" />
                                            <DataGridTemplateColumn Width="110">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="O'chirish" Click="DeleteBlacklistSite_Click" 
                                                                Padding="14,3" Height="28" FontSize="12" Cursor="Hand"
                                                                Background="#FEE2E2" Foreground="#DC2626" BorderBrush="#FEE2E2">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!-- Empty State -->
                                    <StackPanel x:Name="BlacklistEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24,0,24" Visibility="Collapsed">
                                        <Border Background="#F1F5F9" Width="48" Height="48" CornerRadius="24" HorizontalAlignment="Center" Margin="0,0,0,10">
                                            <materialDesign:PackIcon Kind="FormatListBulleted" Width="24" Height="24" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Qora ro'yxatda saytlar mavjud emas" FontWeight="SemiBold" FontSize="14" Foreground="#475569" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock Text="Yuqoridagi maydonga domenlarni yozib &quot;Ro'yxatni saqlash&quot; tugmasini bosing" FontSize="12.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <!-- TAB 2: WHITELIST -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="CheckCircle" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Oq ro'yxat" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                            <Border x:Name="WhitelistActivePill" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="10" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="Faol" Foreground="#16A34A" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </TabItem.Header>

                    <StackPanel>
                        <!-- Main Card -->
                        <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,16" 
                                BorderBrush="#EBF2FC" BorderThickness="1" Effect="{StaticResource CardElevationEffect}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <materialDesign:PackIcon Kind="FileDocumentOutline" Width="20" Height="20" Foreground="#0066FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Ruxsat etilgan saytlar ro'yxati (har bir qatorga bittadan):" 
                                               FontWeight="Bold" FontSize="14" Foreground="#0F172A" VerticalAlignment="Center" />
                                </StackPanel>
                                
                                <Border Background="White" BorderBrush="#0066FF" BorderThickness="1.5" CornerRadius="8" Padding="2">
                                    <TextBox x:Name="WhitelistTextBox" 
                                             AcceptsReturn="True" 
                                             VerticalScrollBarVisibility="Auto" 
                                             Height="105" 
                                             FontSize="14" 
                                             FontFamily="Consolas"
                                             Foreground="#0F172A"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="8" />
                                </Border>

                                <!-- Button Actions Row -->
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0" VerticalAlignment="Center">
                                    <!-- Save Button -->
                                    <Button Click="SaveWhitelistButton_Click" Style="{StaticResource AppPrimaryButtonStyle}" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="ContentSaveOutline" Width="18" Height="18" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="RO'YXATNI SAQLASH" Foreground="White" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Sort Button -->
                                    <Button Click="SortWhitelistButton_Click" Style="{StaticResource AppSecondaryButtonStyle}" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="SortAlphabeticalAscending" Width="18" Height="18" Foreground="#0066FF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="ALIFBO BO'YICHA SARALASH" Foreground="#0066FF" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Clear Button -->
                                    <Button Click="ClearWhitelistText_Click" Style="{StaticResource AppDangerSoftButtonStyle}" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18" Foreground="#DC2626" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="TOZALASH" Foreground="#DC2626" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- In-page Save Notification Badge -->
                                    <Border x:Name="WhitelistNotificationBadge" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="10,6" Visibility="Collapsed" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CheckCircleOutline" Width="16" Height="16" Foreground="#059669" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="WhitelistNotificationText" Text="Oq ro'yxat saqlandi" Foreground="#065F46" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Whitelist Note Box -->
                        <Border Background="#F0F8FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <materialDesign:PackIcon Kind="LightbulbOutline" Width="18" Height="18" Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Oq ro'yxat Eslatmasi:" FontWeight="Bold" FontSize="13" Foreground="#0369A1" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="• Bu rejim yoqilganda faqat shu yerga kiritilgan saytlarga ruxsat beriladi, qolgan barcha saytlar bloklanadi." FontSize="12.5" Foreground="#334155" Margin="0,0,0,3"/>
                                <TextBlock Text="• Masalan: google.com kiritilsa, uning barcha subdomenlari (www.google.com) ham ochiladi." FontSize="12.5" Foreground="#334155" Margin="0,0,0,3"/>
                                <TextBlock Text="• *.edu.uz kiritilsa, barcha .edu.uz bilan tugaydigan ta'lim saytlariga ruxsat beriladi." FontSize="12.5" Foreground="#334155" Margin="0,0,0,3"/>
                                <TextBlock Text="• Sayt ichidagi aniq o'yin/sahifalarni taqiqlash uchun boshiga '!' qo'ying (Masalan: !scratch.mit.edu/explore*)" FontWeight="SemiBold" FontSize="12.5" Foreground="#0369A1"/>
                            </StackPanel>
                        </Border>

                        <!-- Saved Sites Table -->
                        <Border Background="White" CornerRadius="14" Padding="20,16" 
                                BorderBrush="#EBF2FC" BorderThickness="1" Effect="{StaticResource CardElevationEffect}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,14">
                                    <!-- Modern Search Capsule with Focus Ring -->
                                    <Border DockPanel.Dock="Right" Style="{StaticResource ModernInputContainerStyle}"
                                            Height="38" Width="260" Padding="12,0" VerticalAlignment="Center">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            
                                            <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="18" Height="18" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            
                                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock x:Name="SearchWhitelistPlaceholder" Text="Saytlarni qidirish..." Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                                <TextBox x:Name="SearchWhitelistTextBox" TextChanged="SearchWhitelist_TextChanged" 
                                                         Background="Transparent" BorderThickness="0" FontSize="13" Foreground="#0F172A" VerticalContentAlignment="Center" Padding="0"/>
                                            </Grid>
                                            
                                            <Button x:Name="ClearSearchWhitelistBtn" Grid.Column="2" Click="ClearSearchWhitelist_Click"
                                                    Width="20" Height="20" Background="Transparent" BorderThickness="0" Cursor="Hand" Visibility="Collapsed" Padding="0" VerticalAlignment="Center">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <materialDesign:PackIcon Kind="CloseCircle" Width="16" Height="16" Foreground="#94A3B8"/>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Title with count pill -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="FormatListBulleted" Width="20" Height="20" Foreground="#0066FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Saqlangan oq ro'yxat saytlari" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                        <Border Background="#EFF6FF" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="WhitelistCountBadge" Text="0 ta" Foreground="#0066FF" FontWeight="Bold" FontSize="12" />
                                        </Border>
                                    </StackPanel>
                                </DockPanel>

                                <Grid MinHeight="140">
                                    <DataGrid x:Name="WhitelistGrid" AutoGenerateColumns="False" IsReadOnly="True" 
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" 
                                              HorizontalGridLinesBrush="#F1F5F9" Background="Transparent" BorderThickness="0"
                                              RowHeight="42" FontSize="13">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Domen / Qoida" Binding="{Binding Domain}" Width="*" />
                                            <DataGridTextColumn Header="Qo'shilgan sana" Binding="{Binding AddedDate}" Width="190" />
                                            <DataGridTemplateColumn Width="110">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="O'chirish" Click="DeleteWhitelistSite_Click" 
                                                                Padding="14,3" Height="28" FontSize="12" Cursor="Hand"
                                                                Background="#FEE2E2" Foreground="#DC2626" BorderBrush="#FEE2E2">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!-- Empty State -->
                                    <StackPanel x:Name="WhitelistEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24,0,24" Visibility="Collapsed">
                                        <Border Background="#F1F5F9" Width="48" Height="48" CornerRadius="24" HorizontalAlignment="Center" Margin="0,0,0,10">
