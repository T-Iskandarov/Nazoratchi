<UserControl x:Class="Nazoratchi.Panel.Views.SitesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Saytlarni boshqarish" FontSize="28" FontWeight="Bold" Margin="0,0,0,16" />

        <!-- Active Mode Selector Card -->
        <materialDesign:Card Grid.Row="1" Padding="16" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Faol rejim:" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Margin="0,0,24,0" />
                <RadioButton x:Name="BlacklistRadio" Content="🚫 Qora ro'yxat (Taqiqlanganlar)" 
                             GroupName="ActiveFilterMode" FontSize="14" Margin="0,0,24,0" 
                             Checked="ActiveMode_Changed" />
                <RadioButton x:Name="WhitelistRadio" Content="✅ Oq ro'yxat (Faqat ruxsat berilganlar)" 
                             GroupName="ActiveFilterMode" FontSize="14" 
                             Checked="ActiveMode_Changed" />
            </StackPanel>
        </materialDesign:Card>

        <!-- Tab Control for Blacklist and Whitelist -->
        <TabControl x:Name="SitesTabControl" Grid.Row="2" Style="{StaticResource MaterialDesignFilledTabControl}">
            
            <!-- TAB 1: BLACKLIST -->
            <TabItem Header="🚫 Qora ro'yxat">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,16,0,16">
                        <!-- Bulk Text Area Card (LeechBlock Style) -->
                        <materialDesign:Card Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Taqiqlanadigan saytlar ro'yxati (har bir qatorga bittadan):" 
                                           FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                                
                                <TextBox x:Name="BlacklistTextBox" 
                                         AcceptsReturn="True" 
                                         VerticalScrollBarVisibility="Auto" 
                                         Height="130" 
                                         FontSize="14" 
                                         FontFamily="Consolas"
                                         Padding="8"
                                         materialDesign:HintAssist.Hint="masalan:&#x0a;*.facebook.com&#x0a;*tiktok*&#x0a;~casino&#x0a;+mail.google.com"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="RO'YXATNI SAQLASH" Click="SaveBlacklistButton_Click" 
                                            Height="36" Margin="0,0,12,0" 
                                            Style="{StaticResource MaterialDesignRaisedButton}" />
                                    <Button Content="ALIFBO BO'YICHA SARALASH" Click="SortBlacklistButton_Click" 
                                            Height="36" Margin="0,0,12,0" 
                                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                                    <Button Content="TOZALASH" Click="ClearBlacklistText_Click" 
                                            Height="36" 
                                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="#C62828" />
                                </StackPanel>

                                <!-- Tip / Help section like LeechBlock -->
                                <Border Background="#F1F5F9" CornerRadius="6" Padding="12" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="💡 Qoidalar va Maslahatlar (LeechBlock uslubida):" FontWeight="Bold" FontSize="12" Margin="0,0,0,4" Foreground="#1E3A8A"/>
                                        <TextBlock Text="• * yoki ** — ixtiyoriy subdomen yoki qism (masalan: *.youtube.com, *game*, *.bet)" FontSize="12" Foreground="#475569" Margin="0,0,0,2"/>
                                        <TextBlock Text="• + — istisno qoida (masalan: +mail.google.com ga ruxsat beriladi, boshqa google xizmatlari bloklanadi)" FontSize="12" Foreground="#475569" Margin="0,0,0,2"/>
                                        <TextBlock Text="• ~ — kalit so'z (masalan: ~bet domen nomida 'bet' so'zi bo'lgan barcha saytlarni to'xtatadi)" FontSize="12" Foreground="#475569"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Blacklist Sites Table -->
                        <materialDesign:Card Padding="16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBox x:Name="SearchBlacklistTextBox" 
                                             TextChanged="SearchBlacklist_TextChanged" 
                                             materialDesign:HintAssist.Hint="Qidirish..." 
                                             Width="240" 
                                             DockPanel.Dock="Right" 
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
                                    <TextBlock Text="Saqlangan qora ro'yxat saytlari" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                                </DockPanel>

                                <DataGrid x:Name="BlacklistGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="280">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Domen / Qoida" Binding="{Binding Domain}" Width="*" />
                                        <DataGridTextColumn Header="Qo'shilgan sana" Binding="{Binding AddedDate}" Width="180" />
                                        <DataGridTemplateColumn Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="O'chirish" Click="DeleteBlacklistSite_Click" 
                                                            Style="{StaticResource MaterialDesignOutlinedButton}" 
                                                            Padding="8,2" Height="28" Foreground="#C62828" BorderBrush="#C62828" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: WHITELIST -->
            <TabItem Header="✅ Oq ro'yxat">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,16,0,16">
                        <!-- Bulk Text Area Card (LeechBlock Style) -->
                        <materialDesign:Card Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Ruxsat berilgan saytlar ro'yxati (har bir qatorga bittadan):" 
                                           FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                                
                                <TextBox x:Name="WhitelistTextBox" 
                                         AcceptsReturn="True" 
                                         VerticalScrollBarVisibility="Auto" 
                                         Height="130" 
                                         FontSize="14" 
                                         FontFamily="Consolas"
                                         Padding="8"
                                         materialDesign:HintAssist.Hint="masalan:&#x0a;google.com&#x0a;*.edu.uz&#x0a;wikipedia.org"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="RO'YXATNI SAQLASH" Click="SaveWhitelistButton_Click" 
                                            Height="36" Margin="0,0,12,0" 
                                            Style="{StaticResource MaterialDesignRaisedButton}" />
                                    <Button Content="ALIFBO BO'YICHA SARALASH" Click="SortWhitelistButton_Click" 
                                            Height="36" Margin="0,0,12,0" 
                                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                                    <Button Content="TOZALASH" Click="ClearWhitelistText_Click" 
                                            Height="36" 
                                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="#C62828" />
                                </StackPanel>

                                <!-- Tip / Help section -->
                                <Border Background="#F1F5F9" CornerRadius="6" Padding="12" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="💡 Oq ro'yxat Eslatmasi:" FontWeight="Bold" FontSize="12" Margin="0,0,0,4" Foreground="#1E3A8A"/>
                                        <TextBlock Text="• Bu rejim yoqilganda faqat shu yerga kiritilgan saytlarga ruxsat beriladi, qolgan barcha saytlar bloklanadi." FontSize="12" Foreground="#475569" Margin="0,0,0,2"/>
                                        <TextBlock Text="• Masalan: google.com kiritilsa, uning barcha subdomenlari (www.google.com) ham ochiladi." FontSize="12" Foreground="#475569" Margin="0,0,0,2"/>
                                        <TextBlock Text="• *.edu.uz kiritilsa, barcha .edu.uz bilan tugaydigan ta'lim saytlariga ruxsat beriladi." FontSize="12" Foreground="#475569"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Whitelist Sites Table -->
                        <materialDesign:Card Padding="16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBox x:Name="SearchWhitelistTextBox" 
                                             TextChanged="SearchWhitelist_TextChanged" 
                                             materialDesign:HintAssist.Hint="Qidirish..." 
                                             Width="240" 
                                             DockPanel.Dock="Right" 
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
                                    <TextBlock Text="Saqlangan oq ro'yxat saytlari" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                                </DockPanel>

                                <DataGrid x:Name="WhitelistGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="280">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Domen / Qoida" Binding="{Binding Domain}" Width="*" />
                                        <DataGridTextColumn Header="Qo'shilgan sana" Binding="{Binding AddedDate}" Width="180" />
                                        <DataGridTemplateColumn Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="O'chirish" Click="DeleteWhitelistSite_Click" 
                                                            Style="{StaticResource MaterialDesignOutlinedButton}" 
                                                            Padding="8,2" Height="28" Foreground="#C62828" BorderBrush="#C62828" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
