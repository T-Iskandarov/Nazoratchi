<UserControl x:Class="Nazoratchi.Panel.Views.SitesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header matching Image 3 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
            <materialDesign:PackIcon Kind="Earth" Width="28" Height="28" Foreground="#0066FF" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Saytlarni boshqarish" FontSize="26" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Active Mode Selector Card matching Image 3 -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20,16" Margin="0,0,0,16" BorderBrush="#EBF2FC" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#64748B" BlurRadius="14" Direction="270" ShadowDepth="3" Opacity="0.05" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Faol rejim:" FontWeight="Bold" FontSize="14" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,24,0" />
                <RadioButton x:Name="BlacklistRadio" Content="Qora ro'yxat (Taqiqlanganlar)" 
                             GroupName="ActiveFilterMode" FontSize="14" Foreground="#1E293B" Margin="0,0,24,0" 
                             Checked="ActiveMode_Changed" />
                <RadioButton x:Name="WhitelistRadio" Content="Oq ro'yxat (Faqat ruxsat berilganlar)" 
                             GroupName="ActiveFilterMode" FontSize="14" Foreground="#1E293B" 
                             Checked="ActiveMode_Changed" />
            </StackPanel>
        </Border>

        <!-- Native TabControl with Modern Pill Tabs matching Image 3 -->
        <TabControl x:Name="SitesTabControl" Grid.Row="2" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="#475569" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder" CornerRadius="8" Padding="20,10" Margin="0,0,12,14" 
                                        Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand">
                                    <ContentPresenter ContentSource="Header" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="#0066FF" />
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="#0066FF" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: BLACKLIST -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Cancel" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Qora ro'yxat" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Main Card matching Image 3 -->
                        <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderBrush="#EBF2FC" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#64748B" BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.05" />
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <materialDesign:PackIcon Kind="FileDocumentOutline" Width="20" Height="20" Foreground="#0066FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Taqiqlanadigan saytlar ro'yxati (har bir qatorga bittadan):" 
                                               FontWeight="Bold" FontSize="14" Foreground="#0F172A" VerticalAlignment="Center" />
                                </StackPanel>
                                
                                <Border Background="White" BorderBrush="#0066FF" BorderThickness="1.5" CornerRadius="8" Padding="4">
                                    <TextBox x:Name="BlacklistTextBox" 
                                             AcceptsReturn="True" 
                                             VerticalScrollBarVisibility="Auto" 
                                             Height="140" 
                                             FontSize="14" 
                                             FontFamily="Consolas"
                                             Foreground="#0F172A"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="10" />
                                </Border>

                                <!-- Button Actions Row matching Image 3 -->
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <!-- Save Button -->
                                    <Button Click="SaveBlacklistButton_Click" Height="40" Padding="18,0" Cursor="Hand" Margin="0,0,12,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#0066FF" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="ContentSaveOutline" Width="18" Height="18" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="RO'YXATNI SAQLASH" Foreground="White" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Sort Button -->
                                    <Button Click="SortBlacklistButton_Click" Height="40" Padding="18,0" Cursor="Hand" Margin="0,0,12,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="White" BorderBrush="#0066FF" BorderThickness="1.5" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Foreground="#0066FF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="ALIFBO BO'YICHA SARALASH" Foreground="#0066FF" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Clear Button -->
                                    <Button Click="ClearBlacklistText_Click" Height="40" Padding="18,0" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#FFF1F2" BorderBrush="#FECDD3" BorderThickness="1.5" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18" Foreground="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="TOZALASH" Foreground="#EF4444" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- LeechBlock Rules Box matching Image 3 -->
                        <Border Background="#F0F8FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <materialDesign:PackIcon Kind="LightbulbOutline" Width="20" Height="20" Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Qoidalar va Maslahatlar (LeechBlock uslubida):" FontWeight="Bold" FontSize="13" Foreground="#0369A1" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="• &quot;*&quot; yoki &quot;**&quot; — ixtiyoriy subdomen yoki qism (masalan: *.youtube.com, *game*, *bet)" FontSize="13" Foreground="#334155" Margin="0,0,0,4"/>
                                <TextBlock Text="• &quot;+&quot; — istisno qoida (masalan: +mail.google.com ga ruxsat beriladi, boshqa google xizmatlari bloklanadi)" FontSize="13" Foreground="#334155" Margin="0,0,0,4"/>
                                <TextBlock Text="• &quot;~&quot; — kalit so'z (masalan: ~bet domen nomida &quot;bet&quot; so'zi bo'lgan barcha saytlarni to'xtatadi)" FontSize="13" Foreground="#334155"/>
                            </StackPanel>
                        </Border>

                        <!-- Saved Sites Table -->
                        <Border Background="White" CornerRadius="12" Padding="20" BorderBrush="#EBF2FC" BorderThickness="1">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBox x:Name="SearchBlacklistTextBox" 
                                             TextChanged="SearchBlacklist_TextChanged" 
                                             materialDesign:HintAssist.Hint="Qidirish..." 
                                             Width="240" 
                                             DockPanel.Dock="Right" 
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
                                    <TextBlock Text="Saqlangan qora ro'yxat saytlari" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                </DockPanel>

                                <DataGrid x:Name="BlacklistGrid" AutoGenerateColumns="False" IsReadOnly="True" 
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" 
                                          HorizontalGridLinesBrush="#F1F5F9" Background="Transparent" BorderThickness="0"
                                          RowHeight="38" MaxHeight="240">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Domen / Qoida" Binding="{Binding Domain}" Width="*" />
                                        <DataGridTextColumn Header="Qo'shilgan sana" Binding="{Binding AddedDate}" Width="180" />
                                        <DataGridTemplateColumn Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="O'chirish" Click="DeleteBlacklistSite_Click" 
                                                            Padding="10,2" Height="26" FontSize="12"
                                                            Background="#FEE2E2" Foreground="#DC2626" BorderBrush="#FEE2E2" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: WHITELIST -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CheckCircle" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Oq ro'yxat" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Main Card -->
                        <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderBrush="#EBF2FC" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#64748B" BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.05" />
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <materialDesign:PackIcon Kind="FileDocumentOutline" Width="20" Height="20" Foreground="#0066FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Ruxsat etilgan saytlar ro'yxati (har bir qatorga bittadan):" 
                                               FontWeight="Bold" FontSize="14" Foreground="#0F172A" VerticalAlignment="Center" />
                                </StackPanel>
                                
                                <Border Background="White" BorderBrush="#0066FF" BorderThickness="1.5" CornerRadius="8" Padding="4">
                                    <TextBox x:Name="WhitelistTextBox" 
                                             AcceptsReturn="True" 
                                             VerticalScrollBarVisibility="Auto" 
                                             Height="140" 
                                             FontSize="14" 
                                             FontFamily="Consolas"
                                             Foreground="#0F172A"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="10" />
                                </Border>

                                <!-- Button Actions Row -->
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <!-- Save Button -->
                                    <Button Click="SaveWhitelistButton_Click" Height="40" Padding="18,0" Cursor="Hand" Margin="0,0,12,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#0066FF" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="ContentSaveOutline" Width="18" Height="18" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="RO'YXATNI SAQLASH" Foreground="White" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Sort Button -->
                                    <Button Click="SortWhitelistButton_Click" Height="40" Padding="18,0" Cursor="Hand" Margin="0,0,12,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="White" BorderBrush="#0066FF" BorderThickness="1.5" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Foreground="#0066FF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="ALIFBO BO'YICHA SARALASH" Foreground="#0066FF" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Clear Button -->
                                    <Button Click="ClearWhitelistText_Click" Height="40" Padding="18,0" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#FFF1F2" BorderBrush="#FECDD3" BorderThickness="1.5" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18" Foreground="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="TOZALASH" Foreground="#EF4444" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Whitelist Note Box -->
                        <Border Background="#F0F8FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <materialDesign:PackIcon Kind="LightbulbOutline" Width="20" Height="20" Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Oq ro'yxat Eslatmasi:" FontWeight="Bold" FontSize="13" Foreground="#0369A1" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="• Bu rejim yoqilganda faqat shu yerga kiritilgan saytlarga ruxsat beriladi, qolgan barcha saytlar bloklanadi." FontSize="13" Foreground="#334155" Margin="0,0,0,4"/>
                                <TextBlock Text="• Masalan: google.com kiritilsa, uning barcha subdomenlari (www.google.com) ham ochiladi." FontSize="13" Foreground="#334155" Margin="0,0,0,4"/>
                                <TextBlock Text="• *.edu.uz kiritilsa, barcha .edu.uz bilan tugaydigan ta'lim saytlariga ruxsat beriladi." FontSize="13" Foreground="#334155"/>
                            </StackPanel>
                        </Border>

                        <!-- Saved Sites Table -->
                        <Border Background="White" CornerRadius="12" Padding="20" BorderBrush="#EBF2FC" BorderThickness="1">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBox x:Name="SearchWhitelistTextBox" 
                                             TextChanged="SearchWhitelist_TextChanged" 
                                             materialDesign:HintAssist.Hint="Qidirish..." 
                                             Width="240" 
                                             DockPanel.Dock="Right" 
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
                                    <TextBlock Text="Saqlangan oq ro'yxat saytlari" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                </DockPanel>

                                <DataGrid x:Name="WhitelistGrid" AutoGenerateColumns="False" IsReadOnly="True" 
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" 
                                          HorizontalGridLinesBrush="#F1F5F9" Background="Transparent" BorderThickness="0"
                                          RowHeight="38" MaxHeight="240">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Domen / Qoida" Binding="{Binding Domain}" Width="*" />
                                        <DataGridTextColumn Header="Qo'shilgan sana" Binding="{Binding AddedDate}" Width="180" />
                                        <DataGridTemplateColumn Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="O'chirish" Click="DeleteWhitelistSite_Click" 
                                                            Padding="10,2" Height="26" FontSize="12"
                                                            Background="#FEE2E2" Foreground="#DC2626" BorderBrush="#FEE2E2" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
