<Window x:Class="Nazoratchi.Panel.Views.ResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Nazoratchi - Parolni tiklash" Height="580" Width="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Assets/app.ico"
        FontFamily="Segoe UI"
        TextElement.Foreground="#0F172A">
    <Grid>
        <!-- Background Soft Waves & Gradients matching Image 1 -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F1F6FE" Offset="0" />
                <GradientStop Color="#FFFFFF" Offset="0.4" />
                <GradientStop Color="#F3F8FF" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Background Decorative Organic Shapes -->
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Path Data="M -80,-80 C 120,-80 230,40 180,210 C 130,270 -80,240 -80,240 Z" Opacity="0.75">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#D6E8FE" Offset="0" />
                        <GradientStop Color="#EAF4FE" Offset="1" />
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
            <Path Canvas.Right="-60" Canvas.Bottom="-40" 
                  Data="M 0,260 C 110,190 200,230 290,130 L 290,260 Z" Opacity="0.6">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#E3EFFE" Offset="0" />
                        <GradientStop Color="#F1F7FE" Offset="1" />
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
        </Canvas>

        <!-- Main Form Container -->
        <StackPanel Width="320" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,10">
            <!-- Brand Logo (Shield + Nazoratchi) -->
            <Image Source="/Assets/logo1.png" Width="200" Margin="0,0,0,16" 
                   HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />

            <!-- Title & Subtitle -->
            <TextBlock Text="Parolni tiklash" FontSize="24" FontWeight="Bold" 
                       HorizontalAlignment="Center" Foreground="#0F172A" Margin="0,0,0,6" />
            
            <TextBlock Text="Birinchi parol o'rnatilganda berilgan tiklash kalitini kiriting:" 
                       FontSize="13" Foreground="#64748B" TextWrapping="Wrap" 
                       TextAlignment="Center" Margin="0,0,0,20" />

            <!-- Input 1: Recovery Key -->
            <Border Background="White" BorderBrush="#0066FF" BorderThickness="1.5" CornerRadius="8" Height="46" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="KeyVariant" Width="20" Height="20" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <TextBlock x:Name="RecoveryKeyPlaceholder" Grid.Column="1" Text="Tiklash kaliti (masalan: AB12CD34)" Foreground="#94A3B8" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False" Margin="4,0,0,0"/>
                    <TextBox x:Name="RecoveryKeyBox" Grid.Column="1" Background="Transparent" BorderThickness="0" FontSize="14" Foreground="#0F172A" VerticalContentAlignment="Center" Padding="4,0,12,0" TextChanged="RecoveryKeyBox_TextChanged" KeyDown="Input_KeyDown" />
                </Grid>
            </Border>

            <!-- Input 2: New Password -->
            <Border Background="White" BorderBrush="#0066FF" BorderThickness="1.5" CornerRadius="8" Height="46" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="LockOutline" Width="20" Height="20" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <TextBlock x:Name="NewPasswordPlaceholder" Grid.Column="1" Text="Yangi parol" Foreground="#94A3B8" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False" Margin="4,0,0,0"/>
                    <PasswordBox x:Name="NewPasswordBox" Grid.Column="1" Background="Transparent" BorderThickness="0" FontSize="15" Foreground="#0F172A" VerticalContentAlignment="Center" Padding="4,0,4,0" PasswordChanged="NewPasswordBox_PasswordChanged" KeyDown="Input_KeyDown" />
                    <TextBox x:Name="NewPasswordTextBox" Grid.Column="1" Background="Transparent" BorderThickness="0" FontSize="14" Foreground="#0F172A" VerticalContentAlignment="Center" Padding="4,0,4,0" Visibility="Collapsed" TextChanged="NewPasswordTextBox_TextChanged" KeyDown="Input_KeyDown" />
                    <Button Grid.Column="2" Click="ToggleNewPasswordVisibility_Click" Style="{StaticResource MaterialDesignFlatButton}" Padding="0" Height="36" Width="36" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon x:Name="NewPasswordEyeIcon" Kind="EyeOffOutline" Width="18" Height="18" Foreground="#64748B" />
                    </Button>
                </Grid>
            </Border>

            <!-- Input 3: Confirm New Password -->
            <Border Background="White" BorderBrush="#0066FF" BorderThickness="1.5" CornerRadius="8" Height="46" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="LockOutline" Width="20" Height="20" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <TextBlock x:Name="ConfirmNewPasswordPlaceholder" Grid.Column="1" Text="Yangi parolni tasdiqlang" Foreground="#94A3B8" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False" Margin="4,0,0,0"/>
                    <PasswordBox x:Name="ConfirmNewPasswordBox" Grid.Column="1" Background="Transparent" BorderThickness="0" FontSize="15" Foreground="#0F172A" VerticalContentAlignment="Center" Padding="4,0,4,0" PasswordChanged="ConfirmNewPasswordBox_PasswordChanged" KeyDown="Input_KeyDown" />
                    <TextBox x:Name="ConfirmNewPasswordTextBox" Grid.Column="1" Background="Transparent" BorderThickness="0" FontSize="14" Foreground="#0F172A" VerticalContentAlignment="Center" Padding="4,0,4,0" Visibility="Collapsed" TextChanged="ConfirmNewPasswordTextBox_TextChanged" KeyDown="Input_KeyDown" />
                    <Button Grid.Column="2" Click="ToggleConfirmPasswordVisibility_Click" Style="{StaticResource MaterialDesignFlatButton}" Padding="0" Height="36" Width="36" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon x:Name="ConfirmPasswordEyeIcon" Kind="EyeOffOutline" Width="18" Height="18" Foreground="#64748B" />
                    </Button>
                </Grid>
            </Border>

            <!-- Error Message -->
            <TextBlock x:Name="ErrorMessage" Foreground="#DC2626" FontSize="13" 
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed" />

            <!-- Submit Button -->
            <Button Content="PAROLNI TIKLASH" Click="ResetButton_Click" 
                    Height="46" FontSize="15" FontWeight="Bold" Foreground="White" 
                    Cursor="Hand" Margin="0,6,0,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="#0066FF" CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect Color="#0066FF" BlurRadius="14" Direction="270" ShadowDepth="4" Opacity="0.32" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#0052CC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#003D99" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
