<Window x:Class="Nazoratchi.Panel.Views.ResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Nazoratchi - Parolni tiklash" Height="570" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Assets/logo.png"
        Background="#F1F5F9"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    <Grid Margin="20">
        <materialDesign:Card Padding="24" VerticalAlignment="Center">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Image Source="/Assets/logo.png" Width="52" Height="52" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Parolni tiklash" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,14" />

                    <TextBlock Text="Birinchi parol o'rnatilganda berilgan tiklash kalitini kiriting:" 
                               TextWrapping="Wrap" Margin="0,0,0,16" Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="13" TextAlignment="Center" />

                    <TextBox x:Name="RecoveryKeyBox" 
                             materialDesign:HintAssist.Hint="Tiklash kaliti (masalan: AB12CD34)"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             FontSize="15"
                             Margin="0,0,0,14"
                             KeyDown="Input_KeyDown" />

                    <PasswordBox x:Name="NewPasswordBox" 
                                 materialDesign:HintAssist.Hint="Yangi parol"
                                 Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                                 FontSize="15"
                                 Margin="0,0,0,14"
                                 KeyDown="Input_KeyDown" />

                    <PasswordBox x:Name="ConfirmNewPasswordBox" 
                                 materialDesign:HintAssist.Hint="Yangi parolni tasdiqlang"
                                 Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                                 FontSize="15"
                                 Margin="0,0,0,14"
                                 KeyDown="Input_KeyDown" />

                    <TextBlock x:Name="ErrorMessage" Foreground="#FF5252" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" FontSize="13" />

                    <Button Content="PAROLNI TIKLASH" Click="ResetButton_Click" 
                            Height="42" FontSize="14" Margin="0,10,0,0"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                </StackPanel>
            </ScrollViewer>
        </materialDesign:Card>
    </Grid>
</Window>
