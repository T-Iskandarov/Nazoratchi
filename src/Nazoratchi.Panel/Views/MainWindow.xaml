<Window x:Class="Nazoratchi.Panel.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Nazoratchi — Boshqaruv paneli" MinHeight="620" MinWidth="960" Height="720" Width="1080"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/logo.png"
        FontFamily="Segoe UI"
        Background="#F8FAFC"
        TextElement.Foreground="#0F172A">
    
    <Window.Resources>
        <!-- Modern Pill Navigation Item Style -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,11" />
            <Setter Property="Margin" Value="0,3,12,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" 
                                CornerRadius="0,22,22,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EBF3FE" />
                                <Setter Property="Foreground" Value="#0066FF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F1F5F9" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <Border Grid.Row="0" Margin="16,16,16,12" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="/Assets/logo1.png" MaxWidth="190" MaxHeight="95" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <!-- Navigation -->
                <ListBox x:Name="NavListBox" Grid.Row="1" SelectionChanged="NavListBox_SelectionChanged" 
                         Background="Transparent" BorderThickness="0" Margin="0,12,0,0">
                    <ListBoxItem Tag="Dashboard" Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Home" Width="22" Height="22" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Bosh sahifa" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Sites" Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Web" Width="22" Height="22" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Saytlar" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Apps" Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Apps" Width="22" Height="22" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Dasturlar" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Logs" Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ClockOutline" Width="22" Height="22" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Loglar" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Settings" Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CogOutline" Width="22" Height="22" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Sozlamalar" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <!-- Footer with CUBO Logo -->
                <StackPanel Grid.Row="2" Margin="16,16,16,20" TextBlock.FontSize="12">
                    <Border CornerRadius="6" Background="Transparent" Margin="0,0,0,8" HorizontalAlignment="Left"
                            Cursor="Hand" MouseDown="CuboLogo_MouseDown" ToolTip="cubo.uz saytiga o'tish">
                        <Image Source="/Assets/cubo-logo.png" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Text="Muallif: Tursunpo'lat Iskandarov" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="CUBO kompaniyasi tomonidan ishlab chiqilgan" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock>
                        <Hyperlink NavigateUri="https://cubo.uz" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#0066FF">
                            cubo.uz
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area with Background Curves matching Image 2 -->
        <Grid Grid.Column="1">
            <!-- Background Waves -->
            <Canvas IsHitTestVisible="False" ClipToBounds="True">
                <Path Canvas.Right="-60" Canvas.Top="-60" 
                      Data="M 0,0 C 120,40 220,160 220,300 L 300,300 L 300,0 Z" Opacity="0.35">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#D6E8FE" Offset="0" />
                            <GradientStop Color="#EFF6FF" Offset="1" />
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
                <Path Canvas.Right="-40" Canvas.Bottom="-40" 
                      Data="M 0,200 C 80,140 180,180 260,100 L 260,200 Z" Opacity="0.3">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#E2EFFE" Offset="0" />
                            <GradientStop Color="#F1F7FE" Offset="1" />
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
            </Canvas>

            <!-- Active View Content -->
            <ContentControl x:Name="MainContent" Margin="24,20,24,24" />
        </Grid>
    </Grid>
</Window>
