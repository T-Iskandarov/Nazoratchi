<UserControl x:Class="Nazoratchi.Panel.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
            <materialDesign:PackIcon Kind="CogOutline" Width="28" Height="28" Foreground="#0066FF" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Sozlamalar" FontSize="26" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Password Settings -->
                <Border Background="White" CornerRadius="14" Padding="20" Margin="0,0,0,16" BorderBrush="#EBF2FC" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#64748B" BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.05" />
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="LockOutline" Width="20" Height="20" Foreground="#0066FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Parolni o'zgartirish" FontSize="18" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                        </StackPanel>
                        <PasswordBox x:Name="OldPasswordBox" materialDesign:HintAssist.Hint="Joriy parol" Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" Margin="0,0,0,12" />
                        <PasswordBox x:Name="NewPasswordBox" materialDesign:HintAssist.Hint="Yangi parol" Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" Margin="0,0,0,12" />
                        <PasswordBox x:Name="ConfirmPasswordBox" materialDesign:HintAssist.Hint="Yangi parolni tasdiqlang" Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" Margin="0,0,0,16" />
                        <Button Content="PAROLNI SAQLASH" Click="ChangePasswordButton_Click" HorizontalAlignment="Left" 
                                Height="40" Padding="20,0" Background="#0066FF" BorderBrush="#0066FF" Foreground="White" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <!-- DNS Settings -->
                <Border Background="White" CornerRadius="14" Padding="20" Margin="0,0,0,16" BorderBrush="#EBF2FC" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#64748B" BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.05" />
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="Dns" Width="20" Height="20" Foreground="#0066FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Tarmoq sozlamalari (DNS)" FontSize="18" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBox x:Name="DnsTextBox" materialDesign:HintAssist.Hint="DNS Server (Masalan: 8.8.8.8)" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,16" />
                        <Button Content="DNS SAQLASH" Click="SaveDnsButton_Click" HorizontalAlignment="Left" 
                                Height="40" Padding="20,0" Background="#0066FF" BorderBrush="#0066FF" Foreground="White" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <!-- Service Management -->
                <Border Background="White" CornerRadius="14" Padding="20" Margin="0,0,0,16" BorderBrush="#EBF2FC" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#64748B" BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.05" />
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="ShieldSyncOutline" Width="20" Height="20" Foreground="#0066FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Xizmatni boshqarish" FontSize="18" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="Holat: " Foreground="#64748B" VerticalAlignment="Center" FontSize="14" />
                            <TextBlock x:Name="ServiceStatusLabel" Text="Tekshirilmoqda..." FontWeight="Bold" FontSize="14" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="ISHGA TUSHIRISH" Click="StartServiceButton_Click" Margin="0,0,12,0" 
                                    Height="40" Padding="18,0" Background="#16A34A" BorderBrush="#16A34A" Foreground="White" FontWeight="Bold" />
                            <Button Content="TO'XTATISH" Click="StopServiceButton_Click" Margin="0,0,12,0" 
                                    Height="40" Padding="18,0" Background="#DC2626" BorderBrush="#DC2626" Foreground="White" FontWeight="Bold" />
                            <Button Content="QAYTA ISHGA TUSHIRISH" Click="RestartServiceButton_Click" 
                                    Height="40" Padding="18,0" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#0066FF" Foreground="#0066FF" FontWeight="Bold" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- About Section -->
                <Border Background="White" CornerRadius="14" Padding="20" Margin="0,0,0,16" BorderBrush="#EBF2FC" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#64748B" BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.05" />
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Image Source="/Assets/logo.png" Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Nazoratchi v1.0.0" FontSize="18" FontWeight="Bold" Foreground="#0F172A" />
                                    <TextBlock Text="Kompyuter va internetni nazorat qilish tizimi" FontSize="13" Foreground="#64748B" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Muallif: Tursunpo'lat Iskandarov" Margin="0,0,0,4" Foreground="#64748B" FontSize="13" />
                            <TextBlock Text="CUBO kompaniyasi tomonidan ishlab chiqilgan" Margin="0,0,0,4" Foreground="#64748B" FontSize="13" />
                            <TextBlock Margin="0,0,0,4" FontSize="13">
                                <Hyperlink NavigateUri="https://cubo.uz" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#0066FF">
                                    https://cubo.uz
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>

                        <!-- CUBO Logo -->
                        <Border Grid.Column="1" VerticalAlignment="Center" Margin="16,0,16,0" Cursor="Hand" MouseDown="CuboLogo_MouseDown" ToolTip="cubo.uz saytiga o'tish">
                            <Image Source="/Assets/cubo-logo.png" Height="64" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
