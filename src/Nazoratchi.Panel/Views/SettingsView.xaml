<UserControl x:Class="Nazoratchi.Panel.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Sozlamalar" FontSize="28" FontWeight="Bold" Margin="0,0,0,24" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Password Settings -->
                <materialDesign:Card Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Parolni o'zgartirish" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />
                        <PasswordBox x:Name="OldPasswordBox" materialDesign:HintAssist.Hint="Joriy parol" Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" Margin="0,0,0,12" />
                        <PasswordBox x:Name="NewPasswordBox" materialDesign:HintAssist.Hint="Yangi parol" Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" Margin="0,0,0,12" />
                        <PasswordBox x:Name="ConfirmPasswordBox" materialDesign:HintAssist.Hint="Yangi parolni tasdiqlang" Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" Margin="0,0,0,16" />
                        <Button Content="PAROLNI SAQLASH" Click="ChangePasswordButton_Click" HorizontalAlignment="Left" Style="{StaticResource MaterialDesignRaisedButton}" />
                    </StackPanel>
                </materialDesign:Card>

                <!-- DNS Settings -->
                <materialDesign:Card Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Tarmoq sozlamalari (DNS)" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />
                        <TextBox x:Name="DnsTextBox" materialDesign:HintAssist.Hint="DNS Server (Masalan: 8.8.8.8)" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,16" />
                        <Button Content="DNS SAQLASH" Click="SaveDnsButton_Click" HorizontalAlignment="Left" Style="{StaticResource MaterialDesignRaisedButton}" />
                    </StackPanel>
                </materialDesign:Card>

                <!-- Service Management -->
                <materialDesign:Card Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Xizmatni boshqarish" FontSize="20" FontWeight="Bold" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="Holat: " Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center" />
                            <TextBlock x:Name="ServiceStatusLabel" Text="Tekshirilmoqda..." FontWeight="Bold" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="ISHGA TUSHIRISH" Click="StartServiceButton_Click" Margin="0,0,16,0" Background="#2E7D32" BorderBrush="#2E7D32" Foreground="White" />
                            <Button Content="TO'XTATISH" Click="StopServiceButton_Click" Margin="0,0,16,0" Background="#C62828" BorderBrush="#C62828" Foreground="White" />
                            <Button Content="QAYTA ISHGA TUSHIRISH" Click="RestartServiceButton_Click" Style="{StaticResource MaterialDesignOutlinedButton}" />
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>

                <!-- About Section -->
                <materialDesign:Card Padding="16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Image Source="/Assets/logo.png" Width="42" Height="42" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Nazoratchi v1.0.0" FontSize="18" FontWeight="Bold" />
                                    <TextBlock Text="Kompyuter va internetni nazorat qilish tizimi" FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Muallif: Tursunpo'lat Iskandarov" Margin="0,0,0,4" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                            <TextBlock Text="CUBO kompaniyasi tomonidan ishlab chiqilgan" Margin="0,0,0,4" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                            <TextBlock Margin="0,0,0,4">
                                <Hyperlink NavigateUri="https://cubo.uz" RequestNavigate="Hyperlink_RequestNavigate">
                                    https://cubo.uz
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>

                        <!-- CUBO Logo -->
                        <Border Grid.Column="1" VerticalAlignment="Center" Margin="16,0,16,0" Cursor="Hand" MouseDown="CuboLogo_MouseDown" ToolTip="cubo.uz saytiga o'tish">
                            <Image Source="/Assets/cubo-logo.png" Height="64" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                    </Grid>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
