<UserControl x:Class="Nazoratchi.Panel.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="Segoe UI">
    <Grid Margin="0,0,8,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,24" VerticalAlignment="Center">
            <materialDesign:PackIcon Kind="ClockOutline" Width="28" Height="28" Foreground="#0066FF" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Loglar va Hisobotlar" FontSize="26" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Filter Card -->
        <Border Grid.Row="1" Background="White" CornerRadius="16" Padding="20,16" Margin="0,0,0,24" 
                BorderBrush="#EBF2FC" BorderThickness="1" Effect="{StaticResource CardElevationEffect}">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Start Date -->
                <Border Style="{StaticResource ModernInputContainerStyle}" Height="40" Padding="10,0" Margin="0,0,12,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CalendarMonthOutline" Width="18" Height="18" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <DatePicker x:Name="StartDatePicker" Width="130" BorderThickness="0" Background="Transparent" 
                                    VerticalAlignment="Center" FontSize="13" SelectedDateFormat="Short" />
                    </StackPanel>
                </Border>

                <!-- End Date -->
                <Border Style="{StaticResource ModernInputContainerStyle}" Height="40" Padding="10,0" Margin="0,0,12,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CalendarMonthOutline" Width="18" Height="18" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <DatePicker x:Name="EndDatePicker" Width="130" BorderThickness="0" Background="Transparent" 
                                    VerticalAlignment="Center" FontSize="13" SelectedDateFormat="Short" />
                    </StackPanel>
                </Border>

                <!-- Type Selector -->
                <Border Style="{StaticResource ModernInputContainerStyle}" Height="40" Padding="10,0" Margin="0,0,16,8">
                    <ComboBox x:Name="TypeComboBox" Width="130" BorderThickness="0" Background="Transparent" 
                              VerticalAlignment="Center" FontSize="13" SelectionChanged="FilterChanged">
                        <ComboBoxItem Content="Barchasi" IsSelected="True" />
                        <ComboBoxItem Content="Saytlar" />
                        <ComboBoxItem Content="Dasturlar" />
                    </ComboBox>
                </Border>

                <!-- Filter Button -->
                <Button Click="FilterButton_Click" Style="{StaticResource AppPrimaryButtonStyle}" Margin="0,0,12,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="FilterVariant" Width="18" Height="18" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="FILTRLASH" Foreground="White" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Clear Button -->
                <Button Click="ClearLogsButton_Click" Style="{StaticResource AppDangerSoftButtonStyle}" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18" Foreground="#DC2626" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="TOZALASH" Foreground="#DC2626" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>

        <!-- Results Table Card -->
        <Border Grid.Row="2" Background="White" CornerRadius="16" Padding="24,20" 
                BorderBrush="#EBF2FC" BorderThickness="1" Effect="{StaticResource CardElevationEffect}">
            <Grid MinHeight="140">
                <DataGrid x:Name="LogsGrid" AutoGenerateColumns="False" IsReadOnly="True" 
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" 
                          HorizontalGridLinesBrush="#F1F5F9" Background="Transparent" BorderThickness="0"
                          RowHeight="42" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Vaqt" Binding="{Binding Timestamp}" Width="180" />
                        <DataGridTextColumn Header="Tur" Binding="{Binding Type}" Width="110" />
                        <DataGridTextColumn Header="Tafsilot" Binding="{Binding Detail}" Width="*" />
                        <DataGridTemplateColumn Header="Natija" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#FEE2E2" CornerRadius="6" Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Result}" Foreground="#DC2626" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty State -->
                <StackPanel x:Name="LogsEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24,0,24" Visibility="Collapsed">
                    <Border Background="#F1F5F9" Width="48" Height="48" CornerRadius="24" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <materialDesign:PackIcon Kind="ClockOutline" Width="24" Height="24" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Hech qanday log yozuvlari topilmadi" FontWeight="SemiBold" FontSize="14" Foreground="#475569" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="Belgilangan sanalar oralig'ida yoki tanlangan tur bo'yicha hodisalar yo'q" FontSize="12.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
