<Window x:Class="Nazoratchi.Panel.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Nazoratchi - Kirish" Height="570" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="/Assets/logo.png"
        FontFamily="Segoe UI"
        TextElement.Foreground="#0F172A">
    <Grid>
        <!-- Background Soft Waves and Gradients -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F1F6FE" Offset="0" />
                <GradientStop Color="#FFFFFF" Offset="0.4" />
                <GradientStop Color="#F3F8FF" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Background Decorative Organic Shapes -->
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <!-- Top-left large wave -->
            <Path Data="M -80,-80 C 120,-80 230,40 180,210 C 130,270 -80,240 -80,240 Z" Opacity="0.75">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#D6E8FE" Offset="0" />
                        <GradientStop Color="#EAF4FE" Offset="1" />
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
            <!-- Top-left inner accent wave -->
            <Path Data="M -80,-80 C 60,-80 150,20 110,150 C 60,200 -80,170 -80,170 Z" Opacity="0.45">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#BDDDFF" Offset="0" />
                        <GradientStop Color="#DBEDFE" Offset="1" />
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>

            <!-- Bottom-right soft wave -->
            <Path Canvas.Right="-60" Canvas.Bottom="40" 
                  Data="M 0,260 C 110,190 200,230 290,130 L 290,260 Z" Opacity="0.6">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#E3EFFE" Offset="0" />
                        <GradientStop Color="#F1F7FE" Offset="1" />
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
        </Canvas>

        <!-- Main Window Layout -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Form Container -->
            <StackPanel Grid.Row="0" Width="310" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,10">
                <!-- Main Official Brand Artwork (Shield + Nazoratchi Typography) -->
                <Image Source="/Assets/logo1.png" Width="220" Margin="0,0,0,24" 
                       HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />

                <!-- Label -->
                <TextBlock x:Name="InstructionText" Text="Parolni kiriting:" 
                           FontSize="15" FontWeight="SemiBold" Foreground="#1E293B" 
                           Margin="0,0,0,10" HorizontalAlignment="Left" />

                <!-- Password Box with Focus Ring and Eye Toggle -->
                <Border x:Name="PasswordBorder" Style="{StaticResource ModernInputContainerStyle}" Height="44" Margin="0,0,0,14">
                    <Grid Margin="12,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="PasswordPlaceholder" Text="Parol" Foreground="#94A3B8" FontSize="14" 
                                       VerticalAlignment="Center" IsHitTestVisible="False" />
                            <PasswordBox x:Name="PasswordBox" Background="Transparent" BorderThickness="0" 
                                         FontSize="15" Foreground="#0F172A" VerticalContentAlignment="Center" 
                                         Padding="0" KeyDown="PasswordBox_KeyDown" 
                                         PasswordChanged="PasswordBox_PasswordChanged" />
                            <TextBox x:Name="PasswordTextBox" Background="Transparent" BorderThickness="0" 
                                     FontSize="15" Foreground="#0F172A" VerticalContentAlignment="Center" 
                                     Padding="0" KeyDown="PasswordBox_KeyDown" Visibility="Collapsed" 
                                     TextChanged="PasswordTextBox_TextChanged" />
                        </Grid>
                        <Button x:Name="TogglePasswordButton" Grid.Column="1" Click="TogglePassword_Click" Width="34" Height="34" Cursor="Hand"
                                Background="Transparent" BorderBrush="Transparent" Style="{StaticResource MaterialDesignFlatButton}" Padding="0">
                            <materialDesign:PackIcon x:Name="PasswordEyeIcon" Kind="EyeOutline" Width="18" Height="18" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Confirm Password Box (First run only) with Focus Ring and Eye Toggle -->
                <Border x:Name="ConfirmPasswordBorder" Style="{StaticResource ModernInputContainerStyle}" Height="44" Margin="0,0,0,14" Visibility="Collapsed">
                    <Grid Margin="12,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="ConfirmPasswordPlaceholder" Text="Parolni tasdiqlang" Foreground="#94A3B8" FontSize="14" 
                                       VerticalAlignment="Center" IsHitTestVisible="False" />
                            <PasswordBox x:Name="ConfirmPasswordBox" Background="Transparent" BorderThickness="0" 
                                         FontSize="15" Foreground="#0F172A" VerticalContentAlignment="Center" 
                                         Padding="0" KeyDown="PasswordBox_KeyDown" 
                                         PasswordChanged="ConfirmPasswordBox_PasswordChanged" />
                            <TextBox x:Name="ConfirmPasswordTextBox" Background="Transparent" BorderThickness="0" 
                                     FontSize="15" Foreground="#0F172A" VerticalContentAlignment="Center" 
                                     Padding="0" KeyDown="PasswordBox_KeyDown" Visibility="Collapsed" 
                                     TextChanged="ConfirmPasswordTextBox_TextChanged" />
                        </Grid>
                        <Button x:Name="ToggleConfirmPasswordButton" Grid.Column="1" Click="ToggleConfirmPassword_Click" Width="34" Height="34" Cursor="Hand"
                                Background="Transparent" BorderBrush="Transparent" Style="{StaticResource MaterialDesignFlatButton}" Padding="0">
                            <materialDesign:PackIcon x:Name="ConfirmPasswordEyeIcon" Kind="EyeOutline" Width="18" Height="18" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Error Message -->
                <TextBlock x:Name="ErrorMessage" Foreground="#DC2626" FontSize="13" 
                           TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" />

                <!-- Login Button -->
                <Button x:Name="LoginButton" Content="KIRISH" Click="LoginButton_Click" 
                        Height="44" FontSize="14" FontWeight="Bold" Foreground="White" 
                        Cursor="Hand" Margin="0,4,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="#0066FF" CornerRadius="8">
                                <Border.Effect>
                                    <DropShadowEffect Color="#0066FF" BlurRadius="14" Direction="270" ShadowDepth="3" Opacity="0.28" />
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#0052CC" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#003D99" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Forgot Password Button / Link -->
                <Button x:Name="ResetButton" Content="Parolni unutdingizmi?" 
                        Click="ResetButton_Click"
                        Foreground="#0066FF"
                        FontSize="14"
                        FontWeight="Normal"
                        HorizontalAlignment="Center"
                        Margin="0,16,0,0"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="{TemplateBinding Content}" 
                                       Foreground="{TemplateBinding Foreground}" 
                                       FontSize="{TemplateBinding FontSize}" 
                                       Cursor="Hand" />
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- Bottom Footer -->
            <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Background="#F8FAFC" Padding="0,14,0,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="/Assets/cubo-logo.png" Height="22" Margin="0,0,12,0" VerticalAlignment="Center" 
                           Cursor="Hand" MouseDown="CuboLogo_MouseDown" ToolTip="cubo.uz saytiga o'tish" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="|" Foreground="#CBD5E1" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="13" />
                    <TextBlock Text="CUBO kompaniyasi" Foreground="#64748B" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="13" />
                    <TextBlock Text="|" Foreground="#CBD5E1" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="13" />
                    <TextBlock VerticalAlignment="Center" FontSize="13">
                        <Hyperlink NavigateUri="https://cubo.uz" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#0066FF">
                            cubo.uz
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
