<UserControl x:Class="Nazoratchi.Panel.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header matching Image 4 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
            <materialDesign:PackIcon Kind="Apps" Width="28" Height="28" Foreground="#0066FF" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Dasturlarni bloklash" FontSize="26" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Top Card: App Guard Toggle matching Image 4 -->
        <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,16" BorderBrush="#EBF2FC" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#64748B" BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.05" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Shield Badge Icon -->
                <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Background="#EFF6FF" Width="44" Height="44" CornerRadius="22" 
                        VerticalAlignment="Top" Margin="0,0,16,0">
                    <materialDesign:PackIcon Kind="ShieldCheck" Width="22" Height="22" Foreground="#0066FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Title -->
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Dastur o'rnatish va o'chirishni bloklash:" 
                           FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />

                <!-- Modern Pill Toggle Switch matching Image 4 -->
                <ToggleButton x:Name="AppBlockToggle" Grid.Row="0" Grid.Column="2" 
                              Checked="AppBlockToggle_CheckedChanged" Unchecked="AppBlockToggle_CheckedChanged" 
                              Width="52" Height="30" Cursor="Hand" VerticalAlignment="Center">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="SwitchTrack" Background="#CBD5E1" CornerRadius="15">
                                <Grid>
                                    <Ellipse x:Name="SwitchKnob" Width="24" Height="24" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.15" />
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <materialDesign:PackIcon x:Name="KnobCheck" Kind="Check" Width="14" Height="14" Foreground="#0066FF" 
                                                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="SwitchTrack" Property="Background" Value="#0066FF" />
                                    <Setter TargetName="SwitchKnob" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="SwitchKnob" Property="Margin" Value="0,0,3,0" />
                                    <Setter TargetName="KnobCheck" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="KnobCheck" Property="Margin" Value="0,0,8,0" />
                                    <Setter TargetName="KnobCheck" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <!-- Subtitle Description -->
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" 
                           Text="Bu funksiya yoqilganda, o'quvchilar yangi dastur o'rnata olmaydi va mavjud dasturlarni o'chira olmaydi. Setup, install, uninstall, msi fayllar va Dasturlarni o'chirish oynasi bloklanadi." 
                           TextWrapping="Wrap" Foreground="#64748B" FontSize="13" Margin="0,8,0,0" LineHeight="20" />
            </Grid>
        </Border>

        <!-- Bottom Card: Recent Blocked Apps Table matching Image 4 -->
        <Border Grid.Row="2" Background="White" CornerRadius="14" Padding="20" BorderBrush="#EBF2FC" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#64748B" BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.05" />
            </Border.Effect>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Background="#EFF6FF" Width="32" Height="32" CornerRadius="16" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="ClockOutline" Width="18" Height="18" Foreground="#0066FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="So'nggi bloklangan dasturlar" FontSize="18" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                </StackPanel>

                <DataGrid x:Name="BlockedAppsGrid" AutoGenerateColumns="False" IsReadOnly="True" 
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" 
                          HorizontalGridLinesBrush="#F1F5F9" Background="Transparent" BorderThickness="0"
                          RowHeight="42" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Vaqt" Binding="{Binding Timestamp}" Width="180" />
                        <DataGridTextColumn Header="Dastur nomi" Binding="{Binding Detail}" Width="*" />
                        <DataGridTemplateColumn Header="Natija" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#FEE2E2" CornerRadius="6" Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Result}" Foreground="#DC2626" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
